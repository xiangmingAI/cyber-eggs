---
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const githubUrl = import.meta.env.PUBLIC_GITHUB_REPO_URL ?? "https://github.com/";
---

<BaseLayout title="404 · 这枚蛋已经被捡走了">
  <Header />
  <main class="page-shell empty-page">
    <div class="empty-page__copy">
      <p class="eyebrow"><span class="eyebrow__chip">ERROR STATE · 404</span><span class="eyebrow__slashes" aria-hidden="true">///</span></p>
      <strong class="empty-page__code" aria-hidden="true">404</strong>
      <h1>这枚蛋可能已经被捡走了</h1>
      <p>它可能已过期、被领取，或飞去了更远的地方。</p>
      <div class="empty-page__actions">
        <a class="button button--large" href={base}>返回货架 <span aria-hidden="true">→</span></a>
        <a class="button button--large button--outline" href={githubUrl}>去 GitHub</a>
      </div>
    </div>
    <div class="empty-page__visual" aria-hidden="true">
      <span class="lost-tag">
        <i class="lost-tag__egg"></i>
      </span>
      <p class="empty-page__chalk">EGGS<br />GO PLACES.<br />SO DO YOU.</p>
    </div>
  </main>
</BaseLayout>

<style>
  .empty-page {
    min-height: calc(100vh - 76px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 40px;
    align-items: center;
    padding-block: 48px;
  }

  .empty-page__code {
    display: block;
    color: var(--paper);
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(7rem, 18vw, 16rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
  }

  .empty-page h1 {
    margin: 18px 0 0;
    font-size: clamp(1.9rem, 4vw, 3.4rem);
  }

  .empty-page__copy > p:not(.eyebrow) {
    margin: 14px 0 30px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .empty-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .empty-page__visual {
    position: relative;
    min-height: 360px;
  }

  .lost-tag {
    position: absolute;
    left: 50%;
    top: 64px;
    display: block;
    width: 170px;
    height: 230px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
      radial-gradient(circle, #252c27 2px, transparent 2.5px) 0 0 / 24px 24px,
      #10130f;
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.5);
    transform: translateX(-50%) rotate(6deg);
    transform-origin: 50% -60px;
  }

  .lost-tag::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 3px;
    height: 64px;
    background: var(--line);
    transform: translateX(-50%);
  }

  .lost-tag::after {
    content: "";
    position: absolute;
    top: 14px;
    left: 50%;
    width: 16px;
    height: 16px;
    border: 4px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    transform: translateX(-50%);
  }

  .lost-tag__egg {
    position: absolute;
    left: 50%;
    top: 56%;
    display: block;
    width: 78px;
    height: 100px;
    border-radius: 55% 55% 48% 48% / 65% 65% 40% 40%;
    background: var(--yolk);
    box-shadow: 0 0 30px rgba(255, 212, 59, 0.3);
    transform: translate(-50%, -50%);
  }

  .lost-tag__egg::after {
    content: "";
    position: absolute;
    top: 16px;
    right: -18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--fresh);
    box-shadow: 0 0 14px var(--fresh);
  }

  .empty-page__chalk {
    position: absolute;
    right: 8%;
    top: 40px;
    margin: 0;
    color: var(--muted);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    line-height: 1.8;
    opacity: 0.55;
    transform: rotate(3deg);
  }

  @media (max-width: 720px) {
    .empty-page {
      grid-template-columns: 1fr;
      align-content: center;
      padding-block: 36px;
    }

    .empty-page__visual {
      min-height: 300px;
    }

    .empty-page__actions .button {
      width: 100%;
    }

    .empty-page__chalk {
      right: 4%;
      font-size: 0.58rem;
    }
  }
</style>
